# Server-side only. No NEXT_PUBLIC credentials required.
BACKEND_URL=http://127.0.0.1:8000
# Match backend API_ACCESS_TOKEN for public deployment.
BACKEND_API_TOKEN=
# Paste the exact URLs from your ZeroDev Monad TESTNET dashboard.
ZERODEV_RPC_URL=
ZERODEV_PASSKEY_SERVER_URL=
ZERODEV_PAYMASTER_URL=
# Optional sponsorship requires an enabled testnet gas policy.
SPONSOR_GAS=false
MONAD_RPC_URL=https://testnet-rpc.monad.xyz
