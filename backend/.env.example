# Choose gemini or nvidia. Keys stay on the backend.
AI_PROVIDER=gemini
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b
NVIDIA_TIMEOUT_SECONDS=20
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
MONAD_RPC_URL=https://testnet-rpc.monad.xyz
MONAD_CHAIN_ID=10143
MONAD_EXPLORER_URL=https://testnet.monadscan.com
RPC_TIMEOUT_SECONDS=8
GEMINI_TIMEOUT_SECONDS=20
# Default is an explicitly labelled off-chain rehearsal. No fake on-chain success.
SWAP_MODE=mock
MAX_SWAP_MON=10
MAX_TRANSFER_MON=10
MAX_TRANSFER_USDC=1000
# Optional verified ConciergeActivity deployment; leave empty for direct transfers.
ACTIVITY_REGISTRY_ADDRESS=
# Optional Telegram interface: private chats from these numeric user IDs only.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=
BOT_BACKEND_URL=http://127.0.0.1:8000
APP_PUBLIC_URL=https://monad-ai-concierge.vercel.app
# Optional contract deployment tool ONLY. Never needed by the running wallet.
DEPLOYER_PRIVATE_KEY=
PREVIEW_TTL_SECONDS=180
# Generate independent random values (32+ characters) for a public deployment.
PREVIEW_SECRET=
API_ACCESS_TOKEN=
REQUIRE_API_TOKEN=false
RATE_LIMIT_PER_MINUTE=20
